---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../data/services.js';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
>
  <section class="nf">
    <div class="wrap wrap--narrow t-center">
      <p class="t-eyebrow">Error 404</p>
      <h1 class="t-display nf__title t-balance">Esta página no la cortamos.</h1>
      <p class="t-lead nf__text">
        La dirección que abriste no existe o cambió de lugar. Desde aquí puedes seguir:
      </p>

      <div class="nf__actions">
        <a class="btn" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/galeria/">Ver la galería</a>
      </div>

      <ul class="nf__links">
        {
          SERVICES.map((service) => (
            <li>
              <a class="link-arrow" href={`/servicios/${service.slug}/`}>
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  .nf__title {
    margin-top: 0.5rem;
  }

  .nf__text {
    max-width: 44ch;
    margin: 1.25rem auto 0;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--c-hairline);
    list-style: none;
  }
</style>
