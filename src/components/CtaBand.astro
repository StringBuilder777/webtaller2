---
import { waLink } from '../data/site.js';

interface Props {
  title?: string;
  text?: string;
  /** Mensaje con el que se abre WhatsApp. */
  message?: string;
}

const {
  title = '¿Empezamos con el tuyo?',
  text = 'Mándanos la idea, el nombre y para cuándo lo necesitas. Te respondemos con una propuesta y el precio.',
  message = '¡Hola! Me gustaría cotizar un personalizado.',
} = Astro.props;
---

<section class="section section--ink cta">
  <div class="wrap wrap--narrow t-center reveal">
    <h2 class="t-display t-balance">{title}</h2>
    <p class="t-lead cta__text">{text}</p>
    <div class="cta__actions">
      <a class="btn btn--accent" href={waLink(message)} target="_blank" rel="noopener noreferrer">
        Escribir por WhatsApp
      </a>
      <a class="btn btn--ghost" href="/contacto/">Ver formas de contacto</a>
    </div>
  </div>
</section>

<style>
  .cta__text {
    max-width: 48ch;
    margin: 1rem auto 0;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
