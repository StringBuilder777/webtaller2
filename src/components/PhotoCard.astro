---
import { Image } from 'astro:assets';

interface Props {
  photo: { src: ImageMetadata; alt: string; portrait: boolean };
  /** `auto` respeta la proporción original; el resto recorta. */
  ratio?: 'auto' | 'square' | 'portrait' | 'landscape';
  sizes?: string;
  width?: number;
  eager?: boolean;
  class?: string;
}

const {
  photo,
  ratio = 'auto',
  sizes = '(max-width: 700px) 92vw, 30vw',
  width = 900,
  eager = false,
  class: className = '',
} = Astro.props;

const ratios = {
  auto: photo.portrait ? '3 / 4' : '4 / 3',
  square: '1 / 1',
  portrait: '3 / 4',
  landscape: '4 / 3',
};
---

<figure class={`photo ${className}`} style={`--ratio:${ratios[ratio]}`}>
  <Image
    src={photo.src}
    alt={photo.alt}
    width={width}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    {...(eager ? { priority: true } : {})}
  />
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    border-radius: var(--r-md);
    background: #e8e8ed;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }
</style>
