---
import { SERVICES } from '../data/services.js';
import { SITE } from '../data/site.js';

const links = [
  ...SERVICES.map((service) => ({ href: `/servicios/${service.slug}/`, label: service.name })),
  { href: '/galeria/', label: 'Galería' },
  { href: '/contacto/', label: 'Contacto' },
];

/** Normaliza para comparar rutas con y sin barra final. */
const normalize = (path) => (path.endsWith('/') ? path : `${path}/`);
const current = normalize(Astro.url.pathname);
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href="/" aria-label={`${SITE.name}, ir al inicio`}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__word">{SITE.shortName}</span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="nav__link"
            aria-current={current === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="nav__cta" href="/contacto/">Cotizar</a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-sheet"
      data-nav-toggle
    >
      <span class="visually-hidden" data-nav-toggle-label>Abrir menú</span>
      <span class="nav__bun" aria-hidden="true"></span>
      <span class="nav__bun" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__sheet" id="nav-sheet" hidden data-nav-sheet>
    <nav class="nav__sheet-links" aria-label="Menú móvil">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class="nav__sheet-link"
            style={`--i:${i}`}
            aria-current={current === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--c-hairline);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--nav-h);
    max-width: var(--wrap-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  /* El punto holográfico: el único color de la barra. */
  .nav__mark {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background: var(--grad-holo);
    background-size: 220% 100%;
    animation: holo-drift 7s linear infinite;
  }

  .nav__links {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .nav__link {
    color: var(--c-ink);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    opacity: 0.82;
    white-space: nowrap;
    transition: opacity 0.2s var(--ease);
  }

  .nav__link:hover {
    opacity: 1;
    text-decoration: none;
  }

  .nav__link[aria-current='page'] {
    font-weight: 600;
    opacity: 1;
  }

  .nav__cta {
    padding: 0.28rem 0.85rem;
    border-radius: var(--r-pill);
    background: var(--c-ink);
    color: #fff;
    font-size: 0.75rem;
    white-space: nowrap;
    transition: background-color 0.2s var(--ease);
  }

  .nav__cta:hover {
    background: #383838;
    text-decoration: none;
  }

  /* Hamburguesa de dos líneas, como la de apple.com */
  .nav__toggle {
    display: none;
    position: relative;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .nav__bun {
    position: absolute;
    left: 50%;
    width: 1rem;
    height: 1px;
    background: var(--c-ink);
    transition:
      translate 0.3s var(--ease),
      rotate 0.3s var(--ease);
  }

  .nav__bun:nth-of-type(1) {
    translate: -50% -3px;
  }

  .nav__bun:nth-of-type(2) {
    translate: -50% 3px;
  }

  .nav[data-open] .nav__bun:nth-of-type(1) {
    translate: -50% 0;
    rotate: 45deg;
  }

  .nav[data-open] .nav__bun:nth-of-type(2) {
    translate: -50% 0;
    rotate: -45deg;
  }

  .nav__sheet {
    overflow: hidden;
    border-top: 1px solid var(--c-hairline);
  }

  /* El estilo de autor gana al `[hidden]` del navegador: hay que repetirlo. */
  .nav__sheet[hidden] {
    display: none;
  }

  .nav__sheet-links {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 2rem;
  }

  .nav__sheet-link {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--c-hairline);
    color: var(--c-ink);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    opacity: 0;
    translate: 0 0.5rem;
  }

  .nav__sheet-link:hover {
    text-decoration: none;
  }

  .nav[data-open] .nav__sheet-link {
    animation: sheet-in 0.45s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 35ms + 60ms);
  }

  @keyframes sheet-in {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 1023px) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: block;
      margin-left: auto;
    }

    .nav[data-open] {
      height: 100dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__sheet-link {
      opacity: 1;
      translate: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const label = document.querySelector<HTMLElement>('[data-nav-toggle-label]');

  if (nav && toggle && sheet) {
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Al volver a ancho de escritorio el panel deja de aplicar.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
